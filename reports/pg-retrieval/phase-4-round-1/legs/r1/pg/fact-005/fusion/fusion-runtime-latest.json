     "content": "## 4.2.2 恶臭污染物排放标准值，见表2。\n<table id=\"tb-d6d711b0614234635955480a53f52a10-0002\" format=\"html\"><tr><td>序号</td><td>控制项目</td><td>排气筒高度,m</td><td>排放量,kg·h</td></tr><tr><td rowspan=\"10\">1</td><td rowspan=\"10\">硫化氢</td><td>15</td><td>0.33</td></tr><tr><td>20</td><td>0.58</td></tr><tr><td>25</td><td>0.90</td></tr><tr><td>30</td><td>1.3</td></tr><tr><td>35</td><td>1.8</td></tr><tr><td>40</td><td>2.3</td></tr><tr><td>60</td><td>5.2</td></tr><tr><td>80</td><td>9.3</td></tr><tr><td>100</td><td>14</td></tr><tr><td>120</td><td>21</td></tr><tr><td rowspan=\"4\">2</td><td rowspan=\"4\">甲硫醇</td><td>15</td><td>0.04</td></tr><tr><td>20</td><td>0.08</td></tr><tr><td>25</td><td>0.12</td></tr><tr><td>30</td><td>0.17</td></tr></table>\nGB 14554-93\n<table id=\"tb-d6d711b0614234635955480a53f52a10-0003\" format=\"html\"><tr><td>序号</td><td>控制项目</td><td>排气筒高度,m</td><td>排放量,kg/h</td></tr><tr><td rowspan=\"3\">2</td><td rowspan=\"3\">甲硫醇</td><td>35</td><td>0.24</td></tr><tr><td>40</td><td>0.31</td></tr><tr><td>60</td><td>0.69</td></tr><tr><td rowspan=\"7\">3</td><td rowspan=\"7\">甲硫醚</td><td>15</td><td>0.33</td></tr><tr><td>20</td><td>0.58</td></tr><tr><td>25</td><td>0.90</td></tr><tr><td>30</td><td>1.3</td></tr><tr><td>35</td><td>1.8</td></tr><tr><td>40</td><td>2.3</td></tr><tr><td>60</td><td>5.2</td></tr><tr><td rowspan=\"7\">4</td><td rowspan=\"7\">二甲二硫醚</td><td>15</td><td>0.43</td></tr><tr><td>20</td><td>0.77</td></tr><tr><td>25</td><td>1.2</td></tr><tr><td>30</td><td>1.7</td></tr><tr><td>35</td><td>2.4</td></tr><tr><td>40</td><td>3.1</td></tr><tr><td>60</td><td>7.0</td></tr><tr><td rowspan=\"10\">5</td><td rowspan=\"10\">二硫化碳</td><td>15</td><td>1.5</td></tr><tr><td>20</td><td>2.7</td></tr><tr><td>25</td><td>4.2</td></tr><tr><td>30</td><td>6.1</td></tr><tr><td>35</td><td>8.3</td></tr><tr><td>40</td><td>11</td></tr><tr><td>60</td><td>24</td></tr><tr><td>80</td><td>43</td></tr><tr><td>100</td><td>68</td></tr><tr><td>120</td><td>97</td></tr><tr><td rowspan=\"7\">6</td><td rowspan=\"7\">氨</td><td>15</td><td>4.9</td></tr><tr><td>20</td><td>8.7</td></tr><tr><td>25</td><td>14</td></tr><tr><td>30</td><td>20</td></tr><tr><td>35</td><td>27</td></tr><tr><td>40</td><td>35</td></tr><tr><td>60</td><td>75</td></tr></table>\nGB 14554—93\n<table id=\"tb-d6d711b0614234635955480a53f52a10-0004\" format=\"html\"><tr><td>序号</td><td>控制项目</td><td>排气筒高度,m</td><td>排放量,kg/h</td></tr><tr><td rowspan=\"10\">7</td><td rowspan=\"10\">三甲胺</td><td>15</td><td>0.54</td></tr><tr><td>20</td><td>0.97</td></tr><tr><td>25</td><td>1.5</td></tr><tr><td>30</td><td>2.2</td></tr><tr><td>35</td><td>3.0</td></tr><tr><td>40</td><td>3.9*</td></tr><tr><td>60</td><td>8.7</td></tr><tr><td>80</td><td>15</td></tr><tr><td>100</td><td>24</td></tr><tr><td>120</td><td>35</td></tr><tr><td rowspan=\"7\">8</td><td rowspan=\"7\">苯乙烯</td><td>15</td><td>6.5</td></tr><tr><td>20</td><td>12</td></tr><tr><td>25</td><td>18</td></tr><tr><td>30</td><td>26</td></tr><tr><td>35</td><td>35</td></tr><tr><td>40</td><td>45</td></tr><tr><td>60</td><td>104</td></tr><tr><td rowspan=\"7\">9</td><td rowspan=\"7\">臭气浓度</td><td>排气筒高度,m</td><td>标准值(无量纲)</td></tr><tr><td>15</td><td>2000</td></tr><tr><td>25</td><td>6000</td></tr><tr><td>35</td><td>15000</td></tr><tr><td>40</td><td>20000</td></tr><tr><td>50</td><td>40000</td></tr><tr><td>≥60</td><td>60000</td></tr></table>",
