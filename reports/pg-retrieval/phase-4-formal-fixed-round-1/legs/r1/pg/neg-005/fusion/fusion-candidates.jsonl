{"query_id": "neg-005", "query": "GB 3838-2002 的表 1 与 GB 3095-2012 的表 1 是同一张表吗？", "workspace": "default", "pg": {"status": "ok", "search_id": "872d689343a9cbb6", "catalog_snapshot_id": "4919b3938ad93747", "source_snapshot_id": "95f7791fd84171ab727870fc5810d79b4327b0c4fa547d432951e0499a3808f8", "discovery_total": 10, "discovery_captured": true, "chunks": 10, "stale_state": "current", "notes": [], "trace_stages": ["code_exact", "code_exact", "keyword_and", "keyword_and_diagnostics", "keyword_core_and", "keyword_synonym_and", "keyword_or_relaxed", "range_binding"], "sql_statements": {"fetchrow": 8, "fetch": 18, "fetchval": 5}, "trace": [{"stage": "code_exact", "code": "GB3838", "version_requested": "2002", "strict": false, "hits": 1, "version_matched": 1, "selected_versions": ["2002"], "selected_docs": ["doc-91f9049decde09153368d4b69f280e78"]}, {"stage": "code_exact", "code": "GB3095", "version_requested": "2012", "strict": false, "hits": 2, "version_matched": 1, "selected_versions": ["2012"], "selected_docs": ["doc-257d8cf3fdf90e76c31908c4f92fc1a1"]}, {"stage": "keyword_and", "tsquery": "'表1' & '表1' & '同' & '一张' & '表'", "top_k": 20, "restricted_to_code_docs": ["doc-257d8cf3fdf90e76c31908c4f92fc1a1", "doc-91f9049decde09153368d4b69f280e78"], "doc_hits": 0, "chunk_hits": 0, "elapsed_ms": 2}, {"stage": "keyword_and_diagnostics", "per_term": [{"term": "表1", "chunk_hits": 5}, {"term": "表1", "chunk_hits": 5}, {"term": "同", "chunk_hits": 1}, {"term": "一张", "chunk_hits": 0}, {"term": "表", "chunk_hits": 1}], "absent_terms": ["一张"]}, {"stage": "keyword_core_and", "tsquery": "'表1' & '表1' & '同' & '表'", "dropped_absent_terms": ["一张"], "chunk_hits": 0, "note": "terms absent from the corpus cannot participate in AND"}, {"stage": "keyword_synonym_and", "tsquery": "('表1') & ('表1') & ('同') & ('表')", "synonyms_applied": [], "skipped_terms": ["一张"], "chunk_hits": 0, "note": "each concept is an OR group (original + controlled synonyms); concepts are AND-combined; strong constraints kept"},