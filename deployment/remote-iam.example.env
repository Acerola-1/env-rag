# Remote (IAM-backed) Knowledge API deployment — field shapes only.
#
# Copy to an ignored file, fill every value locally, chmod 600, and start:
#
#   ENV_RAG_AUTH_MODE=remote \
#   ENV_RAG_IAM_URL=... ENV_RAG_IAM_ISSUER=... \
#   ENV_RAG_IAM_CLIENT_ID=... ENV_RAG_IAM_CLIENT_SECRET=... \
#   ENV_RAG_IAM_MAPPING=/path/to/remote-mapping.json \
#   python -m env_rag_final.access --port 50202 --iam-mapping /path/to/remote-mapping.json \
#     --record-root .local/remote-iam/records
#
# The gateway refuses to start when any required value is missing, unknown or
# inconsistent.  It never falls back to the local registry.

# ---- mode ----------------------------------------------------------------
# local (default) or remote.  Fixed at process start.
ENV_RAG_AUTH_MODE=remote

# ---- IAM ----------------------------------------------------------------
# Loopback URL of the IAM service.
ENV_RAG_IAM_URL=http://127.0.0.1:50200
# The issuer the IAM puts in its replies; a mismatch rejects every subject.
ENV_RAG_IAM_ISSUER=air-agent-iam
# Consumer credential of the *introspection* client (audience `knowledge`).
# This is a different registration from the SSO client below.
ENV_RAG_IAM_CLIENT_ID=
ENV_RAG_IAM_CLIENT_SECRET=
# Total identity-check deadline in seconds; the contract default is 0.5 and the
# accepted range is (0, 5].  Includes queueing, connect and read.
ENV_RAG_IAM_DEADLINE_SECONDS=0.5

# ---- explicit tenant/resource mapping -----------------------------------
# JSON file: {"tenants": {"<tenant-uuid>": {"knowledge:lib:<code>": "<workspace-id>"}}}
# Keys must be literal tenant UUIDs (never `all`/`default`), values must be
# registered, non-reserved workspace ids.  A library absent here is invisible
# and unreachable in this deployment.
ENV_RAG_IAM_MAPPING=

# ---- SSO (optional, humans only) ---------------------------------------
# Server-side SSO façade: /api/sso/start redirects to the IAM authorize
# endpoint and /api/sso/callback performs the ticket exchange server-side.
ENV_RAG_SSO_CLIENT_ID=
ENV_RAG_SSO_CLIENT_SECRET=
# The consumer's own public base (loopback) and the exact registered callback.
ENV_RAG_PUBLIC_BASE=http://127.0.0.1:50202
ENV_RAG_SSO_CALLBACK=http://127.0.0.1:50202/api/sso/callback

# ---- independent record/log roots --------------------------------------
# Never point remote mode at the local deployment's records: identities,
# tenants and permission summaries are part of every record key.
ENV_RAG_RECORD_ROOT=
ENV_RAG_WORKSPACE_REGISTRY=
