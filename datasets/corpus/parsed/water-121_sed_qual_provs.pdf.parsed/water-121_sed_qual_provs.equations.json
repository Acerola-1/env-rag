    "eq-64d67950d80445ca374bea49d8f39322-0003": {
      "id": "eq-64d67950d80445ca374bea49d8f39322-0003",
      "blockid": "f065daf928590e60b3ed71b7b6ffe4e8",
      "heading": "3) Chemical Exposure Evaluation",
      "parent_headings": [
        "WATER QUALITY CONTROL PLAN FOR ENCLOSED BAYS AND ESTUARIES OF CALIFORNIA"
      ],
      "format": "latex",
      "content": "\\text { Equation   6 } \\quad C _ {\\text { Esti }} = \\sum C _ {\\text { Sed }} \\times B S A F _ {i} \\times S U F _ {i}.",
      "caption": "",
      "footnotes": [],
      "self_ref": "content_list.json#/357"
    },
    "eq-64d67950d80445ca374bea49d8f39322-0004": {
