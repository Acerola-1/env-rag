    {
        "type": "text",
        "text": "附录A",
        "text_level": 1,
        "bbox": [
            449,
            131,
            553,
            154
        ],
        "page_idx": 6
    },
    {
        "type": "text",
        "text": "排放浓度、排放量的计算",
        "text_level": 1,
        "bbox": [
            395,
            156,
            608,
            181
        ],
        "page_idx": 6
    },
    {
        "type": "text",
        "text": "(补充件)",
        "bbox": [
            460,
            181,
            546,
            205
        ],
        "page_idx": 6
    },
    {
        "type": "text",
        "text": "A1 排放浓度",
        "text_level": 2,
        "bbox": [
            74,
            244,
            205,
            267
        ],
        "page_idx": 6
    },
    {
        "type": "equation",
        "text": "$$\nC = \\frac {g}{V _ {\\mathrm{nd}}} \\times 1 0 ^ {6}\n$$",
        "text_format": "latex",
        "bbox": [
            433,
            286,
            570,
            319
        ],
        "page_idx": 6
    },
    {
        "type": "text",
        "text": "式中：C ——恶臭污染物的浓度， $mg/m^{3}$ （干燥的标准状态）；",
        "bbox": [
            74,
            323,
            575,
            347
        ],
        "page_idx": 6
    },
    {
        "type": "text",
        "text": "g ——采样所得的恶臭污染物的重量,g;",
        "bbox": [
            125,
            348,
            471,
            372
        ],
        "page_idx": 6
    },
    {
        "type": "text",
        "text": "$V_{nd}$ ——采样体积，L(干燥的标准状态)。",
        "bbox": [
            114,
            372,
            455,
            397
        ],
        "page_idx": 6
    },
    {
        "type": "text",
        "text": "A2. 排放量",
        "text_level": 2,
        "bbox": [
            74,
            411,
            187,
            435
        ],
        "page_idx": 6
    },
    {
        "type": "equation",
        "text": "$$\nG = C \\cdot Q _ {\\mathrm{and}} \\times 1 0 ^ {- 6}\n$$",
        "text_format": "latex",
        "bbox": [
            411,
            447,
            591,
            469
        ],
        "page_idx": 6
    },
    {
        "type": "text",
        "text": "式中：G —— 恶臭污染物的排放量，kg/h；",
        "bbox": [
            74,
            474,
            428,
            497
        ],
        "page_idx": 6
    },
    {
        "type": "text",
        "text": "$Q_{\\text{and}}$ ——烟囱或排气筒的气体流量, $m^{3}$ (干燥的标准状态)/h。",
        "bbox": [
            107,
            497,
            617,
            522
        ],
        "page_idx": 6
    },
    {
        "type": "text",
        "text": "附加说明：",
