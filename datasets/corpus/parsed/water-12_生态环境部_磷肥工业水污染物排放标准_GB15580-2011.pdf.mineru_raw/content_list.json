        "bbox": [
            147,
            581,
            685,
            598
        ],
        "page_idx": 5
    },
    {
        "type": "text",
        "text": "GB/T 11901—89 水质 悬浮物的测定 重量法",
        "bbox": [
            147,
            600,
            529,
            616
        ],
        "page_idx": 5
    },
    {
        "type": "text",
        "text": "GB/T 11914—89 水质 化学需氧量的测定 重铬酸盐法",
        "bbox": [
            147,
            619,
            598,
            634
        ],
        "page_idx": 5
    },
    {
        "type": "text",
        "text": "HJ/T 84—2001 水质 无机阴离子的测定 离子色谱法",
        "bbox": [
            147,
            637,
            584,
            653
        ],
        "page_idx": 5
    },
    {
        "type": "text",
        "text": "HJ/T 195—2005 水质 氨氮的测定 气相分子吸收光谱法",
        "bbox": [
            147,
            656,
            611,
            672
        ],
        "page_idx": 5
    },
    {
        "type": "text",
        "text": "HJ/T 199—2005 水质 总氮的测定 气相分子吸收光谱法",
        "bbox": [
            147,
            675,
            611,
            690
        ],
        "page_idx": 5
    },
    {
        "type": "text",
        "text": "HJ/T 399—2007 水质 化学需氧量的测定 快速消解分光光度法",
        "bbox": [
            147,
            693,
            663,
            707
        ],
        "page_idx": 5
    },
    {
        "type": "text",
        "text": "HJ 487—2009 水质 氟化物的测定 茜素磺酸锆目视比色法",
        "bbox": [
            147,
            712,
            633,
            726
        ],
        "page_idx": 5
    },
    {
        "type": "text",
        "text": "HJ 488—2009 水质 氟化物的测定 氟试剂分光光度法",
        "bbox": [
            147,
            730,
            596,
            745
        ],
        "page_idx": 5
    },
    {
        "type": "text",
        "text": "HJ 535—2009 水质 氨氮的测定 纳氏试剂分光光度法",
        "bbox": [
            147,
            748,
            596,
            764
        ],
        "page_idx": 5
    },
    {
        "type": "text",
        "text": "HJ 536—2009 水质 氨氮的测定 水杨酸分光光度法",
        "bbox": [
