    "eq-604050f9e19e5eb06c72f76c67ac9779-0003": {
      "id": "eq-604050f9e19e5eb06c72f76c67ac9779-0003",
      "blockid": "0b49dc1c865a2ff723458bbc098fdce6",
      "heading": "a、断面主要污染指标的确定方法",
      "parent_headings": [
        "目录"
      ],
      "format": "latex",
      "content": "\\text{断面超标率} = \\frac {\\text {某评价指标超过III类标准的断面(点位)个数}}{\\text {断面(点位)总数}} \\times 100",
      "caption": "",
      "footnotes": [],
      "self_ref": "content_list.json#/224"
    },
    "eq-604050f9e19e5eb06c72f76c67ac9779-0004": {
      "id": "eq-604050f9e19e5eb06c72f76c67ac9779-0004",
      "blockid": "967c2a75adee287cc46b28e5be93a4cd",
      "heading": "b、湖泊营养状态分级",
      "parent_headings": [
        "目录"
      ],
      "format": "latex",
      "content": "\\begin{array}{l l} T L I (\\Sigma) <   3 0 & \\text {贫营养} \\\\ 3 0 \\leqslant T L I (\\Sigma) \\leqslant 5 0 & \\text {中营养} \\\\ T L I (\\Sigma) > 5 0 & \\text {富营养} \\\\ 5 0 <   T L I (\\Sigma) \\leqslant 6 0 & \\text {轻度富营养} \\\\ 6 0 <   T L I (\\Sigma) \\leqslant 7 0 & \\text {中度富营养} \\\\ T L I (\\Sigma) > 7 0 & \\text {重度富营养} \\end{array}",
      "caption": "",
      "footnotes": [],
      "self_ref": "content_list.json#/237"
    },
    "eq-604050f9e19e5eb06c72f76c67ac9779-0005": {
      "id": "eq-604050f9e19e5eb06c72f76c67ac9779-0005",
      "blockid": "4701cc88f5f40782d23e02b803d7c108",
      "heading": "c、综合营养状态指数计算",
      "parent_headings": [
        "目录"
      ],
      "format": "latex",
      "content": "T L I (\\Sigma) = \\sum_ {j = 1} ^ {m} W j \\cdot T L I (j)",
      "caption": "",
      "footnotes": [],
      "self_ref": "content_list.json#/242"
    },
    "eq-604050f9e19e5eb06c72f76c67ac9779-0006": {
      "id": "eq-604050f9e19e5eb06c72f76c67ac9779-0006",
      "blockid": "4701cc88f5f40782d23e02b803d7c108",
      "heading": "c、综合营养状态指数计算",
      "parent_headings": [
        "目录"
      ],
      "format": "latex",
      "content": "W j = \\frac {r _ {i j} ^ {2}}{\\sum_ {j = 1} ^ {m} r _ {i j} ^ {2}}",
      "caption": "",
      "footnotes": [],
      "self_ref": "content_list.json#/247"
    },
    "eq-604050f9e19e5eb06c72f76c67ac9779-0007": {
      "id": "eq-604050f9e19e5eb06c72f76c67ac9779-0007",
      "blockid": "4701cc88f5f40782d23e02b803d7c108",
      "heading": "c、综合营养状态指数计算",
      "parent_headings": [
        "目录"
      ],
      "format": "latex",
      "content": "T L I (\\mathrm{chla}) = 1 0 (2. 5 + 1. 0 8 6 \\mathrm{lnchla})",
      "caption": "",
      "footnotes": [],
      "self_ref": "content_list.json#/253"
    },
    "eq-604050f9e19e5eb06c72f76c67ac9779-0008": {
      "id": "eq-604050f9e19e5eb06c72f76c67ac9779-0008",
      "blockid": "4701cc88f5f40782d23e02b803d7c108",
      "heading": "c、综合营养状态指数计算",
      "parent_headings": [
        "目录"
      ],
      "format": "latex",
      "content": "T L I (\\mathrm{TP}) = 1 0 (9. 4 3 6 + 1. 6 2 4 \\ln \\mathrm{TP})",
      "caption": "",
      "footnotes": [],
      "self_ref": "content_list.json#/254"
    },
    "eq-604050f9e19e5eb06c72f76c67ac9779-0009": {
