        "bbox": [
            102,
            638,
            141,
            652
        ],
        "page_idx": 5
    },
    {
        "type": "text",
        "text": "直接排放 direct discharge",
        "bbox": [
            137,
            656,
            366,
            672
        ],
        "page_idx": 5
    },
    {
