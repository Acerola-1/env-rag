72</td></tr><tr><td>藏红剂分光光度法</td><td>GB 9803</td></tr><tr><td>30</td><td>乐果</td><td>气相色谱法 $^{3)}$ </td><td></td></tr><tr><td>31</td><td>甲胺磷</td><td></td><td></td></tr><tr><td>32</td><td>甲基对硫磷</td><td>气相色谱法 $^{3)}$ </td><td></td></tr><tr><td>33</td><td>呋喃丹</td><td></td><td></td></tr></table>",
