    {
        "type": "header",
        "text": "Attachment A\nBasin Plan Amendment – Early Life Stage Implementation Provision",
        "bbox": [
            93,
            38,
            477,
            80
        ],
        "page_idx": 4
    },
    {
        "type": "header",
        "text": "Page 4",
        "bbox": [
            855,
            59,
            903,
            78
        ],
        "page_idx": 4
    },
    {
        "type": "footer",
        "text": "Final - 12-01-05",
        "bbox": [
            93,
            884,
            192,
            908
        ],
        "page_idx": 4
    },
    {
        "type": "text",
        "text": "Reference: U.S. EPA 1999 Update of Ambient Water Quality Criteria for Ammonia $^{2}$",
        "bbox": [
            91,
            136,
            562,
            173
        ],
        "page_idx": 5
    },
    {
        "type": "text",
        "text": "$^{2}$ For freshwaters subject to the “Early Life Stage Absent” condition not designated SPWN, the thirty-day average concentration of total ammonia as nitrogen (in mg N/L) shall not exceed the values described by the following equation.",
        "bbox": [
            83,
            616,
            911,
            674
        ],
        "page_idx": 5
    },
    {
        "type": "text",
        "text": "30-day Average Concentration = $\\left(\\frac{0.0577}{1 + 10^{7.688 - pH}} +\\frac{2.487}{1 + 10^{pH - 7.688}}\\right)*1.45*10^{0.028*(25 - MAX(T,7))}$",
        "bbox": [
            85,
            679,
            616,
            739
        ],
        "page_idx": 5
    },
    {
        "type": "text",
        "text": "Where T = temperature expressed in °C.",
        "bbox": [
            84,
            747,
            317,
            777
        ],
        "page_idx": 5
    },
    {
        "type": "text",
        "text": "In addition, for freshwaters, the highest four-day average within the 30-day period shall not exceed 2.5 times the 30-day average objective as calculated above.",
        "bbox": [
            82,
            785,
            878,
            832
        ],
        "page_idx": 5
    },
    {
        "type": "page_number",
        "text": "10",
        "bbox": [
            29,
            435,
            54,
            515
        ],
        "page_idx": 5
    },
    {
        "type": "header",
        "text": "Attachment A\nBasin Plan Amendment – Early Life Stage Implementation Provision",
        "bbox": [
            92,
            24,
            480,
            74
        ],
        "page_idx": 5
    },
    {
        "type": "header",
        "text": "Page 5",
        "bbox": [
            860,
            60,
