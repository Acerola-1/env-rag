  "equations": {
    "eq-c1ce2d3294969747f017dfa68ff34a51-0001": {
      "id": "eq-c1ce2d3294969747f017dfa68ff34a51-0001",
      "blockid": "c5e34a3e7a377ddbee6fa158afb4f76a",
      "heading": "a、断面主要污染指标的确定方法",
      "parent_headings": [
        "二、主要江河"
      ],
      "format": "latex",
      "content": "\\text {超标倍数} = \\frac {\\text {某指标的浓度值} - \\text {该指标的III类水质标准}}{\\text {该指标的III类水质标准}}",
      "caption": "",
      "footnotes": [],
      "self_ref": "content_list.json#/219"
    },
    "eq-c1ce2d3294969747f017dfa68ff34a51-0002": {
