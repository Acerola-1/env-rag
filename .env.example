# Canonical Knowledge deployment: one IAM authority, no local credential source.
ENV_RAG_AUTH_MODE=remote
ENV_RAG_IAM_URL=http://127.0.0.1:19100
ENV_RAG_IAM_ISSUER=air-agent-iam
ENV_RAG_IAM_CLIENT_ID=
ENV_RAG_IAM_CLIENT_SECRET=
