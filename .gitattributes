# Preserve corpus and historical evidence bytes without line-ending conversion.
* -text
datasets/corpus/parsed/**/*.pdf filter=lfs diff=lfs merge=lfs -text
datasets/corpus/parsed/**/*.jpg filter=lfs diff=lfs merge=lfs -text
datasets/corpus/parsed/**/*.png filter=lfs diff=lfs merge=lfs -text
# Extracted source text and historical command output retain original whitespace.
reports/** whitespace=-trailing-space,-blank-at-eof
